{
  "name": "notesapp",
  "productName": "NotesApp",
  "version": "1.0.0",
  "description": "Premium offline-first desktop notes application",
  "author": "NotesApp",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "postinstall": "electron-builder install-app-deps",
    "copy:assets": "node scripts/copy-assets.mjs",
    "pack": "npm run copy:assets && electron-vite build && electron-builder --dir",
    "smoke": "node scripts/smoke-test.mjs",
    "smoke:dev": "node scripts/smoke-test.mjs --dev",
    "test": "node --test \"test/**/*.test.mjs\"",
    "dist": "npm run copy:assets && electron-vite build && electron-builder && npm run smoke"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.10.8",
    "@tiptap/core": "^2.6.6",
    "@tiptap/extension-character-count": "^2.6.6",
    "@tiptap/extension-code-block-lowlight": "^2.6.6",
    "@tiptap/extension-color": "^2.6.6",
    "@tiptap/extension-highlight": "^2.6.6",
    "@tiptap/extension-image": "^2.6.6",
    "@tiptap/extension-link": "^2.6.6",
    "@tiptap/extension-placeholder": "^2.6.6",
    "@tiptap/extension-table": "^2.6.6",
    "@tiptap/extension-table-cell": "^2.6.6",
    "@tiptap/extension-table-header": "^2.6.6",
    "@tiptap/extension-table-row": "^2.6.6",
    "@tiptap/extension-task-item": "^2.6.6",
    "@tiptap/extension-task-list": "^2.6.6",
    "@tiptap/extension-text-align": "^2.6.6",
    "@tiptap/extension-text-style": "^2.6.6",
    "@tiptap/extension-underline": "^2.6.6",
    "@tiptap/pm": "^2.6.6",
    "@tiptap/react": "^2.6.6",
    "@tiptap/starter-kit": "^2.6.6",
    "archiver": "^7.0.1",
    "extract-zip": "^2.0.1",
    "framer-motion": "^11.5.4",
    "highlight.js": "^11.10.0",
    "lowlight": "^3.1.0",
    "lucide-react": "^0.452.0",
    "mammoth": "^1.8.0",
    "pdfjs-dist": "^4.8.69",
    "pdfmake": "^0.2.19",
    "prismjs": "^1.29.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.12.7",
    "sql.js": "^1.12.0",
    "tesseract.js": "^5.1.1",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/extract-zip": "^2.0.2",
    "@types/node": "^20.16.5",
    "@types/prismjs": "^1.26.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "electron": "^33.0.1",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
